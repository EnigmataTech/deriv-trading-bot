# Deriv API
DERIV_APP_ID=1089
DERIV_API_TOKEN=your_deriv_api_token_here

# Database
DATABASE_URL=sqlite:////app/data/trading_database.db

# Authentication (Stytch)
AUTH_ENABLED=true
STYTCH_PROJECT_ID=your_stytch_project_id
STYTCH_SECRET=your_stytch_secret
STYTCH_DOMAIN=https://test.stytch.com

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trade Monitor
ENABLE_TRADE_MONITOR=true
TRADE_MONITOR_INTERVAL=30

# Safety Limits
MAX_DAILY_LOSS=100
MAX_DAILY_TRADES=50
MAX_REQUEST_SIZE=102400

# Logging - optional token pattern to redact from logs
REDACT_TOKEN_PATTERN=
