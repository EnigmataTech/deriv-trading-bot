# Deployed to the VPS at ~/.config/systemd/user/weekly-report.timer
# Enable: systemctl --user enable --now weekly-report.timer  (linger must be on)
[Unit]
Description=Run the weekly strategy report every Monday 09:00

[Timer]
OnCalendar=Mon *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
